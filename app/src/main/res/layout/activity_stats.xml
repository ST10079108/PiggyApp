<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8C8DC"
    tools:context=".StatsActivity">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="36sp"
                android:textColor="#000000"
                android:layout_marginStart="10dp"
                android:textStyle="bold"
                tools:text="Dashboard" />

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <Button
                android:id="@+id/btnBudgetAnalytics"
                android:layout_width="291dp"
                android:layout_height="wrap_content"
                android:textSize="20dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="19dp"
                android:background="@drawable/black_rounded_corners"
                android:text="Budget Analytics"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:text="Start Date"
                android:layout_marginStart="16dp"
                android:textStyle="bold"
                android:background="#FFFFF"
                android:textColor="#000000"
                android:layout_marginTop="35dp" />

            <EditText
                android:id="@+id/etStartDate"
                android:layout_width="231dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/edittext"
                android:hint="dd/mm/yyyy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:text="End Date"
                android:layout_marginStart="16dp"
                android:textStyle="bold"
                android:background="#FFFFF"
                android:textColor="#000000"
                android:layout_marginTop="35dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp">

                <EditText
                    android:id="@+id/etEndDate"
                    android:layout_width="231dp"
                    android:layout_height="48dp"
                    android:background="@drawable/edittext"
                    android:hint="dd/mm/yyyy" />

                <Button
                    android:id="@+id/btnShowGraph"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="OK"
                    android:layout_marginStart="29dp"
                    android:backgroundTint="#000000"
                    android:textColor="#FFFFFF" />
            </LinearLayout>



            <View
                android:layout_width="match_parent"
                android:layout_height="29dp" />

            <ImageView
                android:id="@+id/chartImage"
                android:layout_width="376dp"
                android:layout_height="200dp"
                android:background="@drawable/chart_background"
                android:layout_gravity="center_horizontal"
                android:scaleType="centerCrop" />

            <Button
                android:id="@+id/btnExpenses"
                android:layout_width="291dp"
                android:textSize="20dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="19dp"
                android:background="@drawable/black_rounded_corners"
                android:text="Expenses"
                android:textColor="#FFFFFF" />

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <ImageView
                android:id="@+id/chartImage2"
                android:layout_width="376dp"
                android:layout_height="200dp"
                android:layout_gravity="center_horizontal"
                android:scaleType="centerCrop"
                android:background="@drawable/chart_background" />




        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>